# AI model for the parser and edit agents. Pick ONE provider.

# Google AI Studio (default): get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Or OpenRouter: https://openrouter.ai/settings/keys
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Optional model override (default gemini-3.7-flash, or google/gemini-3.7-flash on OpenRouter)
# MODEL=

# Storage (created on first start)
DATABASE_PATH=data/app.db
UPLOADS_DIR=data/uploads
